---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  canonicalUrl?: string;
  robots?: string;
}

const {
  title = 'IANA — Kosmetyki i Suplementy',
  description = 'IANA — polska marka kosmetyków i suplementów. Dołącz do grona testerów i odkryj nasze produkty.',
  ogImage,
  ogTitle,
  ogDescription,
  ogType = 'website',
  canonicalUrl,
  robots = 'index,follow',
} = Astro.props;

const fallbackCanonicalUrl = new URL(Astro.url.pathname, Astro.url.origin).href;
const resolvedCanonicalUrl = canonicalUrl || fallbackCanonicalUrl;
const defaultOgImage = new URL('/og-default.jpg', Astro.url.origin).href;
const resolvedOgImage = ogImage || defaultOgImage;
const resolvedOgTitle = ogTitle || title;
const resolvedOgDescription = ogDescription || description;

const googleClientId = import.meta.env.PUBLIC_GOOGLE_CLIENT_ID || '';
const facebookAppId = import.meta.env.PUBLIC_FACEBOOK_APP_ID || '';
---

<!doctype html>
<html lang="pl">
  <head>
    <!-- Google Consent Mode -->
    <script data-cookieconsent="ignore">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments)
      }
      gtag("consent", "default", {
        ad_personalization: "denied",
        ad_storage: "denied",
        ad_user_data: "denied",
        analytics_storage: "denied",
        functionality_storage: "denied",
        personalization_storage: "denied",
        security_storage: "granted",
        wait_for_update: 500
      });
      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", false);
    </script>
    <script is:inline>
      const trackingParamPatterns = [
        /^_gl$/,
        /^_ga(?:_.+)?$/,
        /^_gcl(?:_.+)?$/,
        /^gclid$/,
        /^gbraid$/,
        /^wbraid$/,
        /^fbclid$/,
        /^msclkid$/,
      ];
      const reportPaths = new Set([
        "/Raport-Obserwatorium",
        "/raport-obserwatorium",
        "/raport-obserwatorium-az-tyle",
        "/raport-uzytkownikow",
      ]);

      const stripTrackingParams = (url) => {
        let hasTrackingParams = false;

        for (const paramName of Array.from(url.searchParams.keys())) {
          if (trackingParamPatterns.some((pattern) => pattern.test(paramName))) {
            url.searchParams.delete(paramName);
            hasTrackingParams = true;
          }
        }

        return hasTrackingParams;
      };

      const toRelativeUrl = (url) => `${url.pathname}${url.search}${url.hash}`;

      const cleanCurrentUrl = () => {
        const url = new URL(window.location.href);
        if (!stripTrackingParams(url)) {
          return;
        }

        const cleanUrl = `${url.pathname}${url.search}${url.hash}`;
        window.history.replaceState(null, "", cleanUrl);
      };

      const getCleanInternalUrl = (href) => {
        const url = new URL(href, window.location.href);

        if (url.origin !== window.location.origin) {
          return { isInternal: false, url, wasCleaned: false };
        }

        const wasCleaned = stripTrackingParams(url);

        return { isInternal: true, url, wasCleaned };
      };

      const cleanAnchorHref = (anchor) => {
        const href = anchor.getAttribute("href");

        if (!href) {
          return false;
        }

        try {
          const { isInternal, url, wasCleaned } = getCleanInternalUrl(anchor.href);

          if (!isInternal || !wasCleaned) {
            return false;
          }

          anchor.setAttribute("href", toRelativeUrl(url));
          return true;
        } catch {
          return false;
        }
      };

      const cleanInternalLinks = (root = document) => {
        if (root instanceof Element && root.matches("a[href]")) {
          cleanAnchorHref(root);
        }

        root.querySelectorAll?.("a[href]").forEach(cleanAnchorHref);
      };

      cleanCurrentUrl();

      document.addEventListener(
        "click",
        (event) => {
          if (!(event.target instanceof Element) || event.defaultPrevented) {
            return;
          }

          const anchor = event.target.closest("a[href]");

          if (!anchor) {
            return;
          }

          try {
            const { isInternal, url, wasCleaned } = getCleanInternalUrl(anchor.href);
            const isReportLink = reportPaths.has(url.pathname);

            if (!isInternal || (!wasCleaned && !isReportLink)) {
              return;
            }

            const cleanHref = toRelativeUrl(url);
            anchor.setAttribute("href", cleanHref);

            if (anchor.hasAttribute("download") && !wasCleaned) {
              return;
            }

            event.preventDefault();
            event.stopImmediatePropagation();

            const opensNewTab = anchor.target && anchor.target !== "_self";

            if (opensNewTab) {
              window.open(cleanHref, anchor.target, "noopener,noreferrer");
              return;
            }

            window.location.assign(cleanHref);
          } catch {
            return;
          }
        },
        true,
      );

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => cleanInternalLinks());
      } else {
        cleanInternalLinks();
      }

      const linkCleanerObserver = new MutationObserver((mutations) => {
        for (const mutation of mutations) {
          if (mutation.type === "attributes" && mutation.target instanceof HTMLAnchorElement) {
            cleanAnchorHref(mutation.target);
            continue;
          }

          for (const node of mutation.addedNodes) {
            if (node instanceof Element) {
              cleanInternalLinks(node);
            }
          }
        }
      });

      linkCleanerObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["href"],
        childList: true,
        subtree: true,
      });
    </script>
    <!-- End Google Consent Mode-->

    <!-- Google Tag Manager -->
    <script is:inline data-cookieconsent="marketing statistics">(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PR76L396');</script>
    <!-- End Google Tag Manager -->

    <!-- Cookiebot CMP-->
    <script id="Cookiebot" src="https://consent.cookiebot.com/uc.js" data-cbid="5ce9b9bd-8d43-4190-88fe-2d010b6455a6" data-blockingmode="auto" type="text/javascript"></script>
    <!-- End Cookiebot CMP -->

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={resolvedCanonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={resolvedCanonicalUrl} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content="IANA" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedOgTitle} />
    <meta name="twitter:description" content={resolvedOgDescription} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <!-- Google Identity Services -->
    {googleClientId && (
      <script is:inline src="https://accounts.google.com/gsi/client" async defer></script>
    )}
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PR76L396"
height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <slot />

    <!-- Facebook SDK -->
    {facebookAppId && (
      <script is:inline define:vars={{ facebookAppId }}>
        window.fbAsyncInit = function() {
          FB.init({
            appId: facebookAppId,
            cookie: true,
            xfbml: false,
            version: 'v19.0'
          });
        };
        (function(d, s, id) {
          var js, fjs = d.getElementsByTagName(s)[0];
          if (d.getElementById(id)) return;
          js = d.createElement(s); js.id = id;
          js.src = "https://connect.facebook.net/pl_PL/sdk.js";
          js.async = true;
          js.defer = true;
          fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));
      </script>
    )}
  </body>
</html>
