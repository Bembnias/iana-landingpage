---
import { Image } from "astro:assets";

export interface RoutineItem {
  image: any;
  href: string;
}

export interface Props {
  heading?: string;
  items: RoutineItem[];
}

const { heading = "Stwórz swoją codzienną rutynę na nowo:", items } =
  Astro.props;
---

<section class="routine-cross-sell">
  <div class="cross-sell__header">
    <h2 class="cross-sell__title">{heading}</h2>
  </div>

  <div class="cross-sell__content">
    <div class="cross-sell__inner">
      <div class="cross-sell__grid">
        {
          items.map((item) => (
            <div class="cross-sell-card">
              <div class="cross-sell-card__img-wrapper" role="button" tabindex="0" aria-label="Powiększ zdjęcie rutyny">
                <Image
                  src={item.image}
                  alt="Rutyna"
                  class="cross-sell-card__img"
                  data-highres={item.image.src || item.image}
                />
              </div>
              <a href={item.href} class="cross-sell-card__btn">
                ODKRYJ
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<!-- Lightbox dla Routine -->
<div class="routine-lightbox" id="routineLightbox" aria-hidden="true">
  <div class="routine-lightbox__backdrop"></div>
  <button class="routine-lightbox__close" aria-label="Zamknij podgląd">
    <svg width="32" height="32" viewBox="0 0 24 24" fill="none">
      <path d="M18 6L6 18M6 6l12 12" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </button>
  <img class="routine-lightbox__img" src="" alt="Powiększone zdjęcie rutyny" />
</div>

<style>
  .routine-cross-sell {
    width: 100%;
    margin-bottom: 0;
  }

  .cross-sell__header {
    background-color: var(--color-background-green);
    padding: 30px 20px;
    text-align: center;
  }

  .cross-sell__title {
    color: var(--color-dark-green);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0;
  }

  .cross-sell__content {
    background-color: #fafafa;
    padding: 60px 40px;
  }

  .cross-sell__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: center;
  }

  .cross-sell__grid {
    display: flex;
    gap: 36px;
    justify-content: center;
    width: 100%;
  }

  .cross-sell-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    max-width: 400px;
  }

  .cross-sell-card__img-wrapper {
    width: 100%;
    margin-bottom: 24px;
    cursor: zoom-in;
  }

  .cross-sell-card__img {
    width: 100%;
    height: auto;
  }

  .cross-sell-card__btn {
    display: inline-block;
    padding: 12px 40px;
    min-width: 100%;
    background-color: var(--color-white);
    color: var(--color-dark-green);
    font-weight: 700;
    font-size: 1.125rem;
    border: 1px solid var(--color-dark-green);
    border-radius: 50px;
    text-decoration: none;
    transition: all 0.2s ease;
    text-align: center;
  }

  .cross-sell-card__btn:hover {
    background-color: var(--color-background-green);
  }

  @media screen and (max-width: 768px) {
    .cross-sell__grid {
      flex-direction: column;
      align-items: center;
      gap: 40px;
    }
    .cross-sell-card {
      width: 100%;
    }
  }

  /* --- LIGHTBOX --- */
  .routine-lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  .routine-lightbox.is-open {
    opacity: 1;
    visibility: visible;
  }

  .routine-lightbox__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .routine-lightbox__img {
    position: relative;
    max-width: 85vw;
    max-height: 85vh;
    object-fit: contain;
    border-radius: 16px;
    transform: scale(0.92);
    transition: transform 0.3s ease;
    z-index: 1;
  }

  .routine-lightbox.is-open .routine-lightbox__img {
    transform: scale(1);
  }

  .routine-lightbox__close {
    position: absolute;
    top: 24px;
    right: 24px;
    z-index: 2;
    background: rgba(255,255,255,0.15);
    border: none;
    border-radius: 50%;
    width: 48px;
    height: 48px;
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    transition: background 0.2s ease;
  }

  .routine-lightbox__close:hover {
    background: rgba(255,255,255,0.3);
  }
</style>

<script>
  function initRoutineLightbox() {
    const wrappers = document.querySelectorAll('.cross-sell-card__img-wrapper');
    const lightbox = document.getElementById('routineLightbox');
    const lightboxImg = lightbox?.querySelector('.routine-lightbox__img') as HTMLImageElement;
    const lightboxClose = lightbox?.querySelector('.routine-lightbox__close');
    const lightboxBackdrop = lightbox?.querySelector('.routine-lightbox__backdrop');

    if (!lightbox || !lightboxImg) return;

    function openLightbox(src: string) {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = src;
      lightbox.classList.add('is-open');
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeLightbox() {
      if (!lightbox || !lightboxImg) return;
      lightbox.classList.remove('is-open');
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      setTimeout(() => { lightboxImg.src = ''; }, 300); // wyczyszczenie src po animacji
    }

    wrappers.forEach(wrapper => {
      wrapper.addEventListener('click', () => {
        const imgTarget = wrapper.querySelector('.cross-sell-card__img') as HTMLImageElement;
        const src = imgTarget.getAttribute('data-highres') || imgTarget.src;
        openLightbox(src);
      });
      wrapper.addEventListener('keydown', (e) => {
        const evt = e as KeyboardEvent;
        if (evt.key === 'Enter' || evt.key === ' ') {
          evt.preventDefault();
          const imgTarget = wrapper.querySelector('.cross-sell-card__img') as HTMLImageElement;
          const src = imgTarget.getAttribute('data-highres') || imgTarget.src;
          openLightbox(src);
        }
      });
    });

    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxBackdrop?.addEventListener('click', closeLightbox);

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('is-open')) return;
      if (e.key === 'Escape') closeLightbox();
    });
  }

  document.addEventListener("astro:page-load", initRoutineLightbox);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initRoutineLightbox);
  } else {
    initRoutineLightbox();
  }
</script>
