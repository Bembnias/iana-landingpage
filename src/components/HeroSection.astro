---
import { Image } from "astro:assets";
import heroBackground from "../assets/hero-background.png";

/**
 * HeroSection — główna sekcja hero na landing page.
 * Pełnoekranowe tło z hero-background.png, tekst marketingowy po lewej.
 * BEM: .hero, .hero__content, .hero__heading, .hero__highlight
 */
---

<section class="hero" id="hero-section">
  <Image
    class="hero__background"
    src={heroBackground}
    alt="iana hero section banner"
    role="presentation"
    fetchpriority="high"
    loading="eager"
  />

  <div class="hero__content">
    <h1 class="hero__heading">
      Nie chcemy starzeć się<br />
      według czyichś zasad.<br />
      Dojrzałość piszemy <strong class="hero__highlight">po swojemu</strong>.
    </h1>

    <aside class="hero__report" aria-labelledby="hero-report-heading">
      <h2 class="hero__report-heading" id="hero-report-heading">
        Sprawdź, jak starzeją się Polacy
      </h2>
      <a class="hero__report-cta" href="/Raport-Obserwatorium" target="_blank">
        PRZECZYTAJ RAPORT
      </a>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    width: 100%;
    min-height: 70vh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -1;
  }

  .hero__content {
    position: relative;
    z-index: 1;
    max-width: var(--max-width);
    width: 100%;
    margin: 0 auto;
    padding: 0;
    padding-top: calc(var(--navbar-height) + 48px);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .hero__heading {
    flex: 1;
    color: var(--color-white);
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 400;
    line-height: 1.4;
    max-width: 700px;
  }

  .hero__highlight {
    font-weight: 700;
    background-color: var(--color-light-green);
    padding: 2px 10px;
    border-radius: 30px;
    white-space: nowrap;
  }

  .hero__report {
    flex: 0 1 390px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 32px;
    background-color: var(--color-dark-green);
    border-radius: 24px;
    text-align: center;
  }

  .hero__report-heading {
    color: var(--color-white);
    font-size: clamp(1.05rem, 1.55vw, 1.25rem);
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
  }

  .hero__report-cta {
    display: inline-block;
    padding: 10px 20px;
    background-color: var(--color-light-green);
    color: var(--color-white);
    font-size: 1.125rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    border-radius: 50px;
    transition:
      background-color 0.2s ease,
      transform 0.15s ease;
  }

  .hero__report-cta:hover {
    background-color: #23900a;
    transform: translateY(-1px);
  }

  .hero__report-cta:focus-visible {
    outline: 3px solid var(--color-white);
    outline-offset: 3px;
  }

  /* --- Mobile --- */
  @media screen and (max-width: 1545px) {
    .hero__content {
      padding-left: 24px;
      padding-right: 24px;
    }
  }

  @media screen and (max-width: 768px) {
    .hero__content {
      flex-direction: column;
      align-items: center;
      padding-top: calc(var(--navbar-height) + 48px + 24px);
      padding-bottom: 48px;
    }

    .hero__heading {
      text-align: center;
      font-size: clamp(1.5rem, 6vw, 2.25rem);
    }

    .hero__report {
      flex-basis: auto;
      width: min(100%, 420px);
      align-items: center;
      padding: 28px 24px;
      text-align: center;
    }

    .hero__report-heading {
      white-space: normal;
    }

    .hero__report-cta {
      padding: 8px 14px;
      font-size: 0.75rem;
      letter-spacing: 0.02em;
    }
  }
</style>
