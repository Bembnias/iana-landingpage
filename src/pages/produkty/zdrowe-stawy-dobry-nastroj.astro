---
import ProductTemplate from "../../components/ProductTemplate.astro";

// Obrazy Galerii
import img1 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_2.png";
import img2 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_1.png";
import img3 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_3.png";
import img4 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_4.png";
import img5 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_5.png";
import img6 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_6.png";
import img7 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_7.png";
import img8 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_8.png";
import img9 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_9.png";
import img10 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_10.png";
import img11 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_11.png";
import img12 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_12.png";
import img13 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_13.png";
import img14 from "../../assets/banner-nastroj/Suplement_Dobry_Nastroj_14.png";

const galleryImages = [
  img1,
  img2,
  img3,
  img4,
  img5,
  img6,
  img7,
  img8,
  img9,
  img10,
  img11,
  img12,
  img13,
  img14,
];

// SVG
import iconPodwojneDzialanie from "../../assets/stawy-podwojne-dzialanie.svg";

// Lower section components
import IngredientsCarousel from "../../components/IngredientsCarousel.astro";
import LifestyleBanner from "../../components/LifestyleBanner.astro";
import RoutineCrossSell from "../../components/RoutineCrossSell.astro";

// Lower section images
import czarnaPorzeczka from "../../assets/ingredients-carousel/czarna-porzeczka.png";
import bambus from "../../assets/ingredients-carousel/bambus.png";
import witaminaC from "../../assets/ingredients-carousel/witamina-C.png";
import szafran from "../../assets/ingredients-carousel/szafran.png";
import lifestyleBanner from "../../assets/stawy-lifestyle-banner.png";
import imgElastycznosc from "../../assets/lifestyle-elastycznosc.png";
import imgMobilnosc from "../../assets/lifestyle-mobilnosc.png";
import imgKomfort from "../../assets/lifestyle-komfort.png";
import { Image } from "astro:assets";

const ingredients = [
  {
    bgImage: czarnaPorzeczka,
    title: "CZARNA PORZECZKA",
    descriptionHtml: `W suplemencie diety <strong>iana Stawy Zdrowe Stawy + Dobry Nastrój</strong> zastosowano standaryzowany <strong>ekstrakt wodny z liści czarnej porzeczki (Ribes nigrum)</strong>, otrzymany opatentowaną metodą uzyskiwania dawki <strong>ipowder®</strong>, odpowiadającej 3 dawkom surowca roślinnego*. Czarna porzeczka (Ribes nigrum) jest rośliną tradycyjnie wykorzystywaną w fitoterapii w celu wspierania komfortu stawów¹². Liście czarnej porzeczki zawierają naturalne związki bioaktywne, w tym flawonoidy (m.in. kwercetynę i kemferol) oraz proantocyjanidyny, cenione za swoje właściwości biologiczne¹. Związki te mogą <strong>wspierać utrzymanie prawidłowego funkcjonowania stawów oraz komfort ruchu².</strong><br/><br/><small>*Kraj pochodzenia: Hiszpania¹<br/> Vidal. Phytothérapie: les plantes de A à Z - Cassis. https://www.vidal.fr/parapharmacie/phytotherapie-plantes/cassis-ribes-nigrum.html (dostęp: kwiecień 2024).² Serrano A. i in. Związki bioaktywne w ekstraktach z tradycyjnych ziół oraz ich potencjalne działanie przeciwzapalne na zdrowie. Medicines, 2018;5:76.</small>`,
  },
  {
    bgImage: bambus,
    title: "BAMBUS TRZCINOWY",
    descriptionHtml: `W suplemencie <strong>diety iana Stawy Zdrowe Stawy + Dobry Nastrój</strong> zastosowano sproszkowaną żywicę z bambusa trzcinowego (Bambusa arundinacea) standaryzowaną na ≥75% krzemionki (SiO₂), która wspiera naturalne funkcjonowanie organizmu*. <strong>Bambus trzcinowy</strong> jest rośliną wykorzystywaną w tradycyjnej medycynie ajurwedyjskiej i indyjskiej¹. Sok z bambusa jest bogaty w krzemionkę, która może wspierać tkanki chrzęstne oraz uczestniczyć w procesach syntezy i stabilizacji kolagenu¹². Dzięki wysokiej zawartości krzemionki składniki pozyskiwane z bambusa mogą <strong>wspierać utrzymanie prawidłowego funkcjonowania stawów oraz komfort ruchu².</strong><br/><br/><small>*Kraj pochodzenia: Francja<br/>¹ Encyclopédie des plantes médicinales. Larousse. 2001. ISBN: 2-03-560252-1.² Jugdaohsingh R. Silicon and bone health. J Nutr Health Aging. 2007;11:99-110.</small>`,
  },
  {
    bgImage: witaminaC,
    title: "WITAMINA C",
    descriptionHtml: `W suplemencie diety <strong>iana Stawy Zdrowe Stawy + Dobry Nastrój</strong> zastosowano witaminę C w ilości 60 mg w porcji dziennej*, która wspiera prawidłowe funkcjonowanie organizmu. <strong>Witamina C</strong> odgrywa istotną rolę w syntezie kolagenu, który jest ważnym składnikiem tkanki łącznej budującej m.in. naczynia krwionośne, ścięgna, więzadła, kości i chrząstki¹. Dzięki swoim <strong>właściwościom antyoksydacyjnym</strong> witamina C pomaga również chronić komórki przed stresem oksydacyjnym wywołanym przez wolne rodniki².<br/><br/><small>*W 2 tabletkach </br> 
    ¹Vidal. Compléments alimentaires – Vitamine C. https://www.vidal.fr/parapharmacie/complements-alimentaires/vitamine-c-acide-ascorbique.html (dostęp: 06.03.2024). ² Berche P. L’histoire du scorbut. Revue de Biologie Médicale, nr 347, marzec 2019.</small>`,
  },
  {
    bgImage: szafran,
    title: "SZAFRAN",
    descriptionHtml: `W suplemencie diety <strong>iana Stawy Zdrowe Stawy + Dobry Nastrój</strong> zastosowano Safr’Inside™ – standaryzowany suchy ekstrakt ze znamion krokusa (Crocus sativus), który zawiera naturalne związki bioaktywne, takie jak krocyna i safranal*. <strong>Szafran (Crocus sativus)</strong> jest rośliną, która w ostatnich latach wzbudza duże zainteresowanie ze względu na swoje potencjalne właściwości wspierające równowagę nastroju¹. Badania wskazują, że krocyna i safranal <strong>mogą wpływać na aktywność neuroprzekaźników, takich jak serotonina i dopamina</strong>, które odgrywają ważną rolę w regulacji nastroju¹ ².<br/><br/><small>*Kraj pochodzenia: Francja <br/> ¹Hausenblas H.A. et al. Saffron (Crocus sativus L.) and major depressive disorder: a meta-analysis of randomized clinical trials. J Integr Med. 2013;11(6):377–383.² Akhondzadeh S. et al. Comparison of Crocus sativus L. and imipramine in the treatment of mild to moderate depression: a pilot double-blind randomized trial. BMC Complement Altern Med. 2004;4:12.</small>`,
  },
];

const routineItems = [
  {
    title:
      "Działa <br/><span style='color: var(--color-blue)'>CHŁODZĄCO</span>",
    image: imgMobilnosc,
    href: "/rutyna/mobilnosc-i-spokoj",
  },
  {
    title:
      "Działa <br/><span style='color: var(--color-yellowish)'>ROZLUŹNIAJĄCO</span>",
    image: imgKomfort,
    href: "/rutyna/komfort-i-odpoczynek",
  },
  {
    title:
      "Działa <br/><span style='color: var(--color-red)'>ROZGRZEWAJĄCO</span>",
    image: imgElastycznosc,
    href: "/rutyna/elastycznosc-i-energia",
  },
];
---

<ProductTemplate
  themeColor="var(--color-purple)"
  ctaColor="var(--color-orange)"
  productCategory="Suplement diety"
  productTitle="ZDROWE STAWY"
  productSubtitle="+ DOBRY NASTRÓJ"
  images={galleryImages}
  buyNowUrl="https://allegro.pl/produkt/suplement-diety-iana-stawy-zdrowe-stawy-dobry-nastroj-60-tabletek-bb997054-ad32-4c82-ae76-6143b3657631?offerId=18357427626"
>
  <Fragment slot="short-desc">
    <p>
      Zawiera standaryzowane ekstrakty od europejskich, sprawdzonych dostawców.
    </p>
  </Fragment>

  <Fragment slot="attributes">
    <li>Pomaga utrzymać pozytywny nastrój</li>
    <li>Wspiera komfort i wspomaga zdrowie stawów</li>
  </Fragment>

  <Fragment slot="usage-heading">
    <h3 class="usage-heading">ZALECENIA DOTYCZĄCE STOSOWANIA:</h3>
  </Fragment>

  <Fragment slot="usage-short">
    <p>2 tabletki dziennie, popić dużą ilością wody.</p>
  </Fragment>

  <Fragment slot="description">
    <p>
      Czy dolegliwości stawów mają negatywny wpływ na Twoją codzienna aktywność?
      Czy obciąża to twoja aktywność psychiczną?<br /> Nie należy lekceważyć znaczenia
      nastroju i równowagi emocjonalnej w przypadku codziennych dolegliwości lub sztywności
      stawów. Czarna porzeczka (667 mg*) wspomaga zdrowie stawów, witamina C (40 mg*)
      przyczynia się do prawidłowego tworzenia kolagenu, zapewniając prawidłowe funkcjonowanie
      chrząstki, bambus (100 mg*) poprawia komfort stawów, a szafran (30 mg*) pomaga
      utrzymać równowagę emocjonalną, wspierając pozytywny nastrój.
    </p>
    <p>* w porcji dziennej (2 tabletki)</p>
  </Fragment>

  <Fragment slot="usage-tips">
    <p>
      1 opakowanie to program wystarczający na 1 miesiąc, w razie potrzeby można
      powtórzyć. 60 tabletek z podziałką.
    </p>
  </Fragment>

  <Fragment slot="precautions">
    <p>
      Przeznaczony dla osób dorosłych. Nie zaleca się stosowania u kobiet w
      ciąży i/lub karmiących piersią, w przypadku obrzękowej niewydolności serca
      lub nerek, w przypadku leczenia przeciwdepresyjnego. Nie należy
      przekraczać zalecanej porcji do spożycia w ciągu dnia. Suplement diety nie
      może być stosowany jako substytut (zamiennik) zróżnicowanej diety.
      Przechowywać w sposób niedostępny dla małych dzieci. Przechowywać w
      zamkniętym pudełku na tabletki, z dala od źródeł ciepła (&lt;30°C),
      wilgoci i światła.
    </p>
  </Fragment>

  <Fragment slot="origin-section">
    <h2 class="details-heading">POCHODZENIE SKŁADNIKÓW:</h2>
    <div class="details-text">
      <p>
        Składniki aktywne zawarte w suplemencie diety IANA Stawy Zdrowe stawy i
        dobry nastrój są pochodzenia roślinnego, od europejskich, sprawdzonych
        dostawców.
      </p>
      <p>
        <br /> Składniki: <br />

        Ekstrakt z lisci czarnej porzeczki (Ribes nigrum L.), substancje
        wypełniajace: celuloza i fosforan dwuwapniowy, sproszkowana zywica
        bambusa (Bambusa bambos (L.) Voss.), witamina C (kwas L-askorbinowy),
        substancje przeciwzbrylajace: mono- i diglicerydy kwasów tłuszczowych i
        sole magnezowe kwasów tłuszczowych, ekstrakt z znamienia szafranu
        (Crocus sativus L.), substancja zagęszczająca: sól sodowa
        karboksymetylocelulozy usieciowana.
      </p>
    </div>
  </Fragment>

  <Fragment slot="disclaimer">
    <p style="font-style: italic; margin-top: 32px; font-size: 0.875rem;">
      Suplement diety. Nie zastępuje zróżnicowanej diety.
    </p>
  </Fragment>

  <Fragment slot="custom-highlights">
    <div
      class="custom-highlights-nastroj"
      style="display: flex; align-items: flex-start; justify-content: space-between; margin-bottom: 40px;"
    >
      <div style="flex: 1; text-align: right; margin-top: 8px;">
        <div
          style="color: var(--color-dark-green); font-weight: 400; line-height: 1.1; text-transform: uppercase; display: inline-block; margin-bottom: 8px; font-size: 1.25rem;"
        >
          KORZYŚCI<br />
          <span style="font-weight: 700;">DLA CIAŁA</span>
        </div>
        <div
          style="border-bottom: 2px solid var(--color-purple); margin: 4px 0"
        >
        </div>
        <div style="color: var(--color-mint); font-size: 1.125rem;">
          Łagodzenie dyskomfortu stawów
        </div>
      </div>
      <div style="margin: 0 40px; flex-shrink: 0; align-self: center;">
        <Image
          src={iconPodwojneDzialanie}
          alt="Podwójne działanie"
          style="height: 120px;"
        />
      </div>
      <div style="flex: 1; text-align: left; margin-top: 8px;">
        <div
          style="color: var(--color-dark-green); font-weight: 400; line-height: 1.1; text-transform: uppercase; display: inline-block; margin-bottom: 8px; font-size: 1.25rem;"
        >
          KORZYŚCI<br />
          <span style="font-weight: 700;">DLA UMYSŁU</span>
        </div>
        <div
          style="border-bottom: 2px solid var(--color-purple); margin: 4px 0"
        >
        </div>
        <div style="color: var(--color-mint); font-size: 1.125rem;">
          Poprawa dobrostanu
        </div>
      </div>
      <style>
        @media (max-width: 768px) {
          .custom-highlights-nastroj {
            flex-direction: column;
            align-items: center !important;
            gap: 20px;
          }
          .custom-highlights-nastroj > div {
            text-align: center !important;
          }
        }
      </style>
    </div>
  </Fragment>

  <IngredientsCarousel
    heading="Kompleks roślinnych składników aktywnych o podwójnym działaniu"
    ingredients={ingredients}
  />

  <LifestyleBanner image={lifestyleBanner}>
    <p>
      <strong
        >Czy czujesz, że Twoje ciało potrzebuje dziś więcej wsparcia niż kiedyś?</strong
      > Zmiany w sprawności ruchowej mogą pojawiać się stopniowo – wpływając nie tylko
      na komfort ruchu, ale też na nasze codzienne samopoczucie. A przecież swoboda
      poruszania się daje coś więcej niż tylko mobilność. Daje poczucie energii, niezależności
      i równowagi.
    </p>
    <p>
      Dlatego powstała formuła iana Zdrowe stawy i Dobry nastrój, która wspiera
      zdrowie stawów i pomaga odzyskać lekkość ruchu – tak, aby ciało i nastrój
      mogły znów działać w harmonii. <strong
        >Bo dobre samopoczucie zaczyna się od swobody ruchu.</strong
      >
    </p>
  </LifestyleBanner>

  <RoutineCrossSell
    heading="Stwórz swoją codzienną rutynę na nowo:"
    items={routineItems}
  />
</ProductTemplate>
